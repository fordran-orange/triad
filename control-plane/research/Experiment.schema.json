{
  "$defs": {
    "Costs": {
      "additionalProperties": false,
      "properties": {
        "fixed": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Fixed",
          "type": "number"
        },
        "per_share": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Per Share",
          "type": "number"
        },
        "bps": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Bps",
          "type": "number"
        }
      },
      "title": "Costs",
      "type": "object"
    },
    "Partition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "training",
            "validation",
            "test"
          ],
          "title": "Name",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "name",
        "start",
        "end"
      ],
      "title": "Partition",
      "type": "object"
    },
    "Sizing": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "fixed_shares",
          "enum": [
            "fixed_shares",
            "fixed_dollars",
            "portfolio_percentage"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Value",
          "type": "number"
        }
      },
      "title": "Sizing",
      "type": "object"
    },
    "Slippage": {
      "additionalProperties": false,
      "properties": {
        "bps": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Bps",
          "type": "number"
        },
        "spread_bps": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Spread Bps",
          "type": "number"
        }
      },
      "title": "Slippage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "hypothesis": {
      "title": "Hypothesis",
      "type": "string"
    },
    "created_by": {
      "default": "CODEX",
      "title": "Created By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "status": {
      "default": "DEFINED",
      "title": "Status",
      "type": "string"
    },
    "strategy_version": {
      "default": "periodic-fixture-v1",
      "enum": [
        "periodic-fixture-v1",
        "hold-fixture-v1"
      ],
      "title": "Strategy Version",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "symbols": {
      "items": {
        "type": "string"
      },
      "title": "Symbols",
      "type": "array"
    },
    "timeframe": {
      "default": "1m",
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "1d"
      ],
      "title": "Timeframe",
      "type": "string"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Parameters",
      "type": "object"
    },
    "directions": {
      "default": [
        "LONG",
        "SHORT"
      ],
      "items": {
        "enum": [
          "LONG",
          "SHORT"
        ],
        "type": "string"
      },
      "title": "Directions",
      "type": "array"
    },
    "fees_model": {
      "$ref": "#/$defs/Costs"
    },
    "slippage_model": {
      "$ref": "#/$defs/Slippage"
    },
    "position_sizing_model": {
      "$ref": "#/$defs/Sizing"
    },
    "execution_model": {
      "const": "CLOSE_SIGNAL_NEXT_OPEN",
      "default": "CLOSE_SIGNAL_NEXT_OPEN",
      "title": "Execution Model",
      "type": "string"
    },
    "initial_capital": {
      "default": 10000,
      "exclusiveMinimum": 0,
      "title": "Initial Capital",
      "type": "number"
    },
    "random_seed": {
      "default": 42,
      "title": "Random Seed",
      "type": "integer"
    },
    "code_commit": {
      "title": "Code Commit",
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "partitions": {
      "items": {
        "$ref": "#/$defs/Partition"
      },
      "title": "Partitions",
      "type": "array"
    },
    "selected_partition": {
      "default": "test",
      "enum": [
        "training",
        "validation",
        "test"
      ],
      "title": "Selected Partition",
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "hypothesis",
    "dataset_id",
    "dataset_version",
    "symbols",
    "start_time",
    "end_time",
    "code_commit",
    "environment",
    "acceptance_criteria",
    "partitions"
  ],
  "title": "Experiment",
  "type": "object"
}
