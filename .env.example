# Copy with tools/init_env.py to generate independent, random local passwords.
POSTGRES_DB=triad
POSTGRES_USER=triad_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
LOCAL_MODEL_ENABLED=false
# Human/host API authorization only. Never include this token in agent context.
TRIAD_OPERATOR_TOKEN=REPLACE_WITH_OPERATOR_SECRET
# A product's own key for Core's reasoning route (Mission 14); issue it with
# tools/issue_product_key.ps1 -Product aegis, never by hand.
# AEGIS_PRODUCT_KEY=

